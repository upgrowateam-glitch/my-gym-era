# Settings for docker-compose.yml on the VPS.
# Copy to .env on the VPS and fill in. Never upload .env to Git or paste it in chat.

# Database password (long and random). Generate one on the VPS with:
#   openssl rand -hex 24
DB_PASSWORD=

# Login token secret (at least 32 characters). Generate one on the VPS with:
#   openssl rand -base64 48
JWT_SECRET=

# Port the API is opened on (must be free on the VPS).
API_PORT=4200

# Public address of the API, used in uploaded file links.
# For testing: http://<VPS-IP>:4200   Later: https://api.<your-domain>
PUBLIC_BASE_URL=
