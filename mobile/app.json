{
  "expo": {
    "name": "FitZone",
    "slug": "my-gym-era",
    "scheme": "mygymera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050607",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mygymera.app"
    },
    "android": {
      "package": "com.mygymera.app",
      "adaptiveIcon": {
        "backgroundColor": "#050607",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "FitZone",
      "backgroundColor": "#050607",
      "shortName": "FitZone"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8cef96ca-4050-4fa1-adac-83a30e938369",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8cef96ca-4050-4fa1-adac-83a30e938369"
      }
    }
  }
}
