# Copy this file to .env and fill in the values.
# .env holds secrets: never share it or paste it into chat.

# API server
PORT=4000

# Local PostgreSQL (database created in pgAdmin / psql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=mygymera_dev
PGUSER=mygymera_app
PGPASSWORD=

# Login tokens. Use a long random value, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Uploaded files (chat images, videos). Folder is relative to backend/.
UPLOAD_DIR=uploads
# Public address of this server, used in uploaded file URLs.
# Leave empty locally; set it when deployed (e.g. https://api.mygymera.com).
PUBLIC_BASE_URL=
